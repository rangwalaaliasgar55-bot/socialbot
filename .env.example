# ---- SocialBot environment -------------------------------------------------
# Copy to .env and fill in what you use. Account credentials are normally
# stored per-account via `socialbot accounts add <platform>` (database),
# but every setting can also come from these env vars.

# SQLite database path (default: ./socialbot.db)
#SOCIALBOT_DB=./socialbot.db

# Protect the web UI + API with a token (dashboards prompts for it once).
# When set, /api/*, /docs and /openapi.json require:  Authorization: Bearer <token>
#SOCIALBOT_API_TOKEN=change-me

# Run growth-bot rules on a schedule too (minutes). 0 = off (default).
# Only enabled rules run, each still respecting its own dry-run/live + caps.
#SOCIALBOT_BOT_INTERVAL=30

# Global webhook notified on every publish (JSON POST)
#SOCIALBOT_WEBHOOK_URL=https://hooks.example.com/publish

# ---- AI content generation (any OpenAI-compatible API) ---------------------
#SOCIALBOT_AI_API_KEY=sk-...
#SOCIALBOT_AI_BASE_URL=https://api.openai.com/v1
#SOCIALBOT_AI_MODEL=gpt-4o-mini

# ---- Platform credentials (optional alternative to `accounts add`) ---------
# X (Twitter)
#TWITTER_ACCESS_TOKEN=
#TWITTER_REFRESH_TOKEN=
#TWITTER_CLIENT_ID=
#TWITTER_USER_ID=

# LinkedIn
#LINKEDIN_ACCESS_TOKEN=
#LINKEDIN_MEMBER_ID=

# Telegram
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# YouTube
#YOUTUBE_ACCESS_TOKEN=
#YOUTUBE_REFRESH_TOKEN=
#YOUTUBE_CLIENT_ID=
#YOUTUBE_CLIENT_SECRET=