# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# AI text provider (OpenAI-compatible). Groq is used by default for chat + draft.
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# AI image provider (OpenAI only — Groq has no image API). Leave blank to skip images.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
